---
import { Picture } from 'astro:assets';
import AuthorshipBadge from './AuthorshipBadge.astro';
import { CONTEXT_LABELS, KIND_LABELS, year, type Work } from '../lib/work';

interface Props {
  entry: Work;
}

const { entry } = Astro.props;
const { data } = entry;
---

<li
  class="card"
  data-kind={data.kind}
  data-context={data.context}
  data-roles={data.roles.join(' ')}
>
  <a class="card__link" href={`/work/${data.slug}/`}>
    {data.cover ? (
      <Picture
        class="card__cover"
        src={data.cover}
        formats={['avif', 'webp']}
        widths={[400, 800]}
        sizes="(max-width: 40rem) 100vw, 22rem"
        alt=""
      />
    ) : (
      <div class="card__cover card__cover--empty" aria-hidden="true">{KIND_LABELS[data.kind]}</div>
    )}
    <div class="card__body">
      <h3 class="card__title">{data.title}</h3>
      {data.position && <p class="card__position">{data.position}</p>}
      <p class="card__meta">
        <span>{KIND_LABELS[data.kind]}</span>
        <span>{CONTEXT_LABELS[data.context]}</span>
        <span>{year(entry)}</span>
        {data.origin === 'fork' && <span>Fork</span>}
        {data.draft && <span class="draft-note">Draft</span>}
      </p>
      <AuthorshipBadge authorship={data.authorship} />
    </div>
  </a>
</li>
