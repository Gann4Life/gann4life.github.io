---
import { embedUrl, type Work } from '../lib/work';
import { withBase } from '../lib/paths';

interface Props {
  items: Work['data']['media'];
  title: string;
}

const { items, title } = Astro.props;
const isLocal = (src: string) => src.startsWith('/');
---

{items.length > 0 && (
  <section class="media-list" aria-label="Media">
    {items.map((item) => {
      const embed = embedUrl(item.type, item.src);
      return (
        <figure class:list={['media', `media--${item.type}`]}>
          {embed ? (
            <iframe
              src={embed}
              title={item.caption || title}
              loading="lazy"
              allow="autoplay; fullscreen; encrypted-media; picture-in-picture"
              allowfullscreen
            />
          ) : isLocal(item.src) && item.type === 'video' ? (
            <video src={withBase(item.src)} controls preload="metadata" />
          ) : isLocal(item.src) && item.type === 'audio' ? (
            <audio src={withBase(item.src)} controls preload="metadata" />
          ) : (
            <a class="button" href={isLocal(item.src) ? withBase(item.src) : item.src} target="_blank" rel="noopener">Open {item.type}</a>
          )}
          {item.caption && <figcaption>{item.caption}</figcaption>}
        </figure>
      );
    })}
  </section>
)}
