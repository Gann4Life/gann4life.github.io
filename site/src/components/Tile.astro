---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/*
 * 4:3 image tile with the text laid over it. Used for categories and works.
 * The image is cropped to fill (never stretched). `index` staggers the
 * cascade animation.
 */
interface Props {
  href: string;
  title: string;
  image?: ImageMetadata;
  eyebrow?: string;
  subtitle?: string;
  index?: number;
  size?: 'large' | 'normal';
}

const { href, title, image, eyebrow, subtitle, index = 0, size = 'normal' } = Astro.props;
---

<a class:list={['tile', `tile--${size}`]} href={href} style={`--i: ${index}`}>
  {image ? (
    <Picture
      class="tile__image"
      src={image}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200]}
      sizes={size === 'large' ? '(max-width: 48rem) 100vw, 50vw' : '(max-width: 40rem) 100vw, (max-width: 80rem) 50vw, 25vw'}
      alt=""
      loading={index < 6 ? 'eager' : 'lazy'}
    />
  ) : (
    <div class="tile__image tile__image--empty" aria-hidden="true"></div>
  )}
  <div class="tile__text">
    {eyebrow && <p class="tile__eyebrow">{eyebrow}</p>}
    <h3 class="tile__title">{title}</h3>
    {subtitle && <p class="tile__subtitle">{subtitle}</p>}
  </div>
</a>
