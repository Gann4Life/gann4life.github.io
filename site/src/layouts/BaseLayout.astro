---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import { profile } from '../profile';
import { getWork, groupByCategory } from '../lib/work';
import { getPosts } from '../lib/blog';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = profile.tagline || `Work by ${profile.name}`, image } = Astro.props;
const pageTitle = title === profile.name ? title : `${title} — ${profile.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const categories = groupByCategory(await getWork()).map((g) => g.category);
const hasBlog = (await getPosts()).length > 0;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#08080b" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-header__name" href="/">{profile.name}</a>
      {(categories.length > 0 || hasBlog) && (
        <nav class="site-header__nav" aria-label="Site">
          {categories.map((c) => (
            <a href={`/work/c/${c.key}/`} aria-current={path.startsWith(`/work/c/${c.key}/`) ? 'page' : undefined}>
              {c.label}
            </a>
          ))}
          {hasBlog && (
            <a href="/blog/" aria-current={path.startsWith('/blog/') ? 'page' : undefined}>Blog</a>
          )}
        </nav>
      )}
    </header>
    <slot />
    <footer class="site-footer">
      {profile.links.length > 0 && (
        <ul class="profile-links">
          {profile.links.map((link) => (
            <li><a href={link.url} rel="me noopener" target="_blank">{link.label}</a></li>
          ))}
        </ul>
      )}
      <p>© {new Date().getFullYear()} {profile.name}</p>
    </footer>
  </body>
</html>
