---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout title="Not found">
  <main class="home">
    <header class="hero hero--compact">
      <p class="hero__kicker">404</p>
      <h1 class="hero__name">Nothing here</h1>
      <p class="hero__roles">That page does not exist or has moved.</p>
      <ul class="pills"><li><a href={withBase('/')}>Back to the home page</a></li></ul>
    </header>
  </main>
</BaseLayout>
