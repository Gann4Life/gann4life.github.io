---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Tile from '../../../components/Tile.astro';
import { CONTEXT_LABELS, KIND_LABELS, getWork, groupByCategory, year, type Category, type Work } from '../../../lib/work';

export async function getStaticPaths() {
  return groupByCategory(await getWork()).map(({ category, entries }) => ({
    params: { category: category.key },
    props: { category, entries },
  }));
}

interface Props {
  category: Category;
  entries: Work[];
}

const { category, entries } = Astro.props;

const eyebrow = (e: Work) =>
  [
    category.kinds.length > 1 ? KIND_LABELS[e.data.kind] : null,
    e.data.context !== 'personal' ? CONTEXT_LABELS[e.data.context] : null,
    e.data.origin === 'fork' ? 'Fork' : null,
    // Authorship stays visible everywhere (docs/2-content-model.md).
    e.data.authorship === 'ai-built' ? 'AI-built' : e.data.authorship === 'ai-assisted' ? 'AI-assisted' : null,
    year(e),
  ]
    .filter(Boolean)
    .join(' · ');
---

<BaseLayout title={category.label}>
  <main class="category">
    <header class="category__header">
      <a class="category__back" href="/">← All categories</a>
      <h1>{category.label}</h1>
    </header>
    <div class="masonry">
      {entries.map((entry, i) => (
        <Tile
          href={`/work/${entry.data.slug}/`}
          title={entry.data.title}
          eyebrow={eyebrow(entry)}
          subtitle={[entry.data.position, entry.data.draft ? 'Draft' : ''].filter(Boolean).join(' · ') || undefined}
          image={entry.data.cover}
          index={i}
        />
      ))}
    </div>
  </main>
</BaseLayout>
