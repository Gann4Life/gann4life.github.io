---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Tile from '../../../components/Tile.astro';
import { profile } from '../../../profile';
import { embedUrl, getWork, groupByCategory, tileMeta, type Category, type Work } from '../../../lib/work';

export async function getStaticPaths() {
  return groupByCategory(await getWork()).map(({ category, entries }) => ({
    params: { category: category.key },
    props: { category, entries },
  }));
}

interface Props {
  category: Category;
  entries: Work[];
}

const { category, entries } = Astro.props;

/*
 * Music is listened to, not looked at: each release gets a compact player
 * right on the category page. Bandcamp's tracklist player is swapped for the
 * slim one here; the full player stays on the entry page.
 */
const player = (e: Work) => {
  const audio = e.data.media.find((m) => m.type === 'audio');
  const url = audio && embedUrl('audio', audio.src);
  return url?.replace('tracklist=true', 'tracklist=false') ?? null;
};
const listen = category.key === 'music' ? entries.filter(player) : [];
const tiles = entries.filter((e) => !listen.includes(e));
---

<BaseLayout title={category.label}>
  <main class="home">
    <header class="hero hero--compact">
      <p class="hero__kicker"><a href="/">{profile.name}</a> / {category.hobby ? 'Hobbies' : 'Work'}</p>
      <h1 class="hero__name">{category.label}</h1>
      <p class="hero__roles">{entries.length} {entries.length === 1 ? 'project' : 'projects'}</p>
    </header>

    {listen.length > 0 && (
      <ul class="players">
        {listen.map((e, i) => (
          <li style={`--i: ${i}`}>
            <a class="players__title" href={`/work/${e.id}/`}>
              {e.data.title}
              <span class="muted">{tileMeta(e, { showKind: false })}{e.data.draft ? ' · Draft' : ''}</span>
            </a>
            <iframe src={player(e)!} title={e.data.title} loading="lazy" allow="autoplay; encrypted-media" />
          </li>
        ))}
      </ul>
    )}

    {tiles.length > 0 && (
      <div class="grid">
        {tiles.map((entry, i) => (
          <Tile
            href={`/work/${entry.id}/`}
            title={entry.data.title}
            eyebrow={tileMeta(entry, { showKind: category.kinds.length > 1 })}
            subtitle={[entry.data.position, entry.data.draft ? 'Draft' : ''].filter(Boolean).join(' · ') || undefined}
            image={entry.data.cover}
            index={i}
          />
        ))}
      </div>
    )}
  </main>
</BaseLayout>
