---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tile from '../components/Tile.astro';
import { profile } from '../profile';
import { getWork, groupByCategory, skills, tileMeta, topRoles } from '../lib/work';

const entries = await getWork();
const groups = groupByCategory(entries);
const featured = entries.filter((e) => e.data.featured);
const latest = entries.filter((e) => !e.data.featured).slice(0, 8);
const roles = topRoles(entries);
const skillList = skills(entries).slice(0, 12);
---

<BaseLayout title={profile.name}>
  <main class="home">
    <section class="hero">
      <p class="hero__kicker">Portfolio</p>
      <h1 class="hero__name">{profile.name}</h1>
      {roles.length > 0 && <p class="hero__roles">{roles.join(' · ')}</p>}
      {profile.tagline && <p class="hero__tagline">{profile.tagline}</p>}
      {profile.bio && <p class="hero__bio">{profile.bio}</p>}
      {profile.links.length > 0 && (
        <ul class="pills" aria-label="Profiles">
          {profile.links.map((link) => (
            <li><a href={link.url} rel="me noopener" target="_blank">{link.label}</a></li>
          ))}
        </ul>
      )}
    </section>

    {featured.length > 0 && (
      <section class="band" aria-labelledby="featured-title">
        <h2 class="band__title" id="featured-title">Featured</h2>
        <div class="grid grid--large">
          {featured.map((e, i) => (
            <Tile href={`/work/${e.data.slug}/`} title={e.data.title} eyebrow={tileMeta(e)} subtitle={e.data.position || undefined} image={e.data.cover} index={i} size="large" />
          ))}
        </div>
      </section>
    )}

    {groups.length > 0 && (
      <section class="band" aria-labelledby="categories-title">
        <h2 class="band__title" id="categories-title">Browse</h2>
        <nav class="grid" aria-label="Categories">
          {groups.map(({ category, entries: items }, i) => (
            <Tile
              href={`/work/c/${category.key}/`}
              title={category.label}
              subtitle={`${items.length} ${items.length === 1 ? 'project' : 'projects'}`}
              image={items.find((e) => e.data.cover)?.data.cover}
              index={i}
            />
          ))}
        </nav>
      </section>
    )}

    {latest.length > 0 && (
      <section class="band" aria-labelledby="latest-title">
        <h2 class="band__title" id="latest-title">Latest</h2>
        <div class="grid">
          {latest.map((e, i) => (
            <Tile href={`/work/${e.data.slug}/`} title={e.data.title} eyebrow={tileMeta(e)} subtitle={e.data.position || undefined} image={e.data.cover} index={i} />
          ))}
        </div>
      </section>
    )}

    {skillList.length > 0 && (
      <section class="band" aria-labelledby="skills-title">
        <h2 class="band__title" id="skills-title">Tools</h2>
        <ul class="pills pills--quiet">{skillList.map((s) => <li>{s}</li>)}</ul>
      </section>
    )}

    {entries.length === 0 && <p class="muted">Nothing published yet.</p>}
  </main>
</BaseLayout>
