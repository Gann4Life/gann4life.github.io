---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tile from '../components/Tile.astro';
import { profile } from '../profile';
import { getWork, groupByCategory, skills } from '../lib/work';

const entries = await getWork();
const groups = groupByCategory(entries);
const skillList = skills(entries);
---

<BaseLayout title={profile.name}>
  <main class="home">
    <section class="home__intro">
      <h1>{profile.name}</h1>
      {profile.tagline && <p class="home__tagline">{profile.tagline}</p>}
      {profile.bio && <p class="home__bio">{profile.bio}</p>}
      {skillList.length > 0 && (
        <ul class="tags home__skills" aria-label="Skills">{skillList.map((s) => <li>{s}</li>)}</ul>
      )}
    </section>

    {groups.length === 0 ? (
      <p class="muted home__empty">Nothing published yet.</p>
    ) : (
      <nav class="categories" aria-label="Categories">
        {groups.map(({ category, entries }, i) => (
          <Tile
            href={`/work/c/${category.key}/`}
            title={category.label}
            subtitle={`${entries.length} ${entries.length === 1 ? 'project' : 'projects'}`}
            image={entries.find((e) => e.data.cover)?.data.cover}
            index={i}
            size="large"
          />
        ))}
      </nav>
    )}
  </main>
</BaseLayout>
