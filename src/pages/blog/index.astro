---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogSplit from '../../components/BlogSplit.astro';
import { profile } from '../../profile';
import { getPosts, listPages } from '../../lib/blog';
import { withBase } from '../../lib/paths';

const pages = listPages(await getPosts());
---

<BaseLayout title="Blog" description={`Devlogs and posts by ${profile.name}.`}>
  {pages.length === 0 ? (
    <main class="blog blog--index">
      <p class="hero__kicker"><a href={withBase('/')}>{profile.name}</a> / Blog</p>
      <h1 class="blog__title">Blog</h1>
      <p class="muted">No posts yet.</p>
    </main>
  ) : (
    <BlogSplit mode="index" posts={pages[0]} selected={pages[0][0]} current={1} last={pages.length} />
  )}
</BaseLayout>
