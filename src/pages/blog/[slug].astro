---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogSplit from '../../components/BlogSplit.astro';
import { getPosts, listPages, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  const pages = listPages(await getPosts());
  return pages.flatMap((posts, i) =>
    posts.map((post) => ({
      params: { slug: post.id },
      props: { post, posts, current: i + 1, last: pages.length },
    })),
  );
}

interface Props {
  post: Post;
  posts: Post[];
  current: number;
  last: number;
}

const { post, posts, current, last } = Astro.props;
const { data } = post;
const ogImage = data.cover ? (await getImage({ src: data.cover, format: 'png', width: 1200 })).src : undefined;
---

<BaseLayout title={data.title} description={data.summary || undefined} image={ogImage}>
  <BlogSplit mode="post" posts={posts} selected={post} current={current} last={last} />
</BaseLayout>
