---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tile from '../components/Tile.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import EditLink from '../components/EditLink.astro';
import { profile } from '../profile';
import { embedUrl, getWork, groupByCategory, skills, tileMeta } from '../lib/work';
import { withBase } from '../lib/paths';
import { getImage } from 'astro:assets';

const entries = await getWork();
const groups = groupByCategory(entries);
const bands = [
  { id: 'work', title: 'Work', items: groups.filter((g) => !g.category.hobby) },
  { id: 'hobbies', title: 'Hobbies', items: groups.filter((g) => g.category.hobby) },
].filter((band) => band.items.length > 0);

// The reel is the banner, so its entry is not repeated under Featured.
const reel = profile.reel ? embedUrl('video', profile.reel) : null;
const isReel = (e: (typeof entries)[number]) => e.data.media.some((m) => m.src === profile.reel);
const featured = entries.filter((e) => e.data.featured && !isReel(e));
const latest = entries.filter((e) => !e.data.featured && !isReel(e)).slice(0, 8);
const skillList = skills(entries).slice(0, 12);
const REEL_CSS =
  '*{margin:0}html,body{height:100%;background:#000;overflow:hidden}' +
  'a{position:absolute;inset:0;display:grid;place-items:center}' +
  'img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}' +
  'span{position:relative;width:72px;height:72px;border-radius:50%;background:rgb(0 0 0/.65);box-shadow:0 0 0 2px #fff}' +
  'span::after{content:"";position:absolute;left:29px;top:22px;border-style:solid;border-width:14px 0 14px 22px;border-color:transparent transparent transparent #fff}' +
  'a:hover span,a:focus-visible span{background:#7c6cff}' +
  'iframe{position:absolute;inset:0;width:100%;height:100%;border:0}';
const REEL_JS =
  "document.querySelector('a').addEventListener('click',(e)=>{e.preventDefault();" +
  "const f=document.createElement('iframe');f.src=e.currentTarget.href;" +
  "f.allow='autoplay; fullscreen; encrypted-media; picture-in-picture';f.allowFullscreen=true;" +
  'f.title=e.currentTarget.getAttribute("aria-label");document.body.replaceChildren(f);});';
const reelEntry = entries.find(isReel);
const reelPoster =
  reel && reelEntry?.data.cover ? (await getImage({ src: reelEntry.data.cover, format: 'webp', width: 1280 })).src : null;
const reelPlay = reel ? `${reel}${reel.includes('?') ? '&' : '?'}autoplay=1` : null;
const reelLabel = `Play the ${profile.name} demo reel`.replaceAll('"', '&quot;');
const reelDoc = reelPoster
  ? `<!doctype html><style>${REEL_CSS}</style><a href="${reelPlay}" aria-label="${reelLabel}"><img src="${reelPoster}" alt=""><span aria-hidden="true"></span></a><script>${REEL_JS}</script>`
  : null;
---

<BaseLayout title={profile.name}>
  <main class="home">
    <section class:list={['hero', { 'hero--reel': reel }]}>
      <div class="hero__text">
        <p class="hero__kicker">Portfolio</p>
        <EditLink path="singleton/profile" label="Edit profile" />
        <h1 class="hero__name">{profile.name}</h1>
        {profile.tagline && <p class="hero__roles">{profile.tagline}</p>}
        {profile.bio && <p class="hero__bio">{profile.bio}</p>}
        <ProfileLinks links={profile.links} class="icon-links--hero" />
      </div>
      {reel && (
        <div class="hero__reel">
          <iframe
            src={reel}
            srcdoc={reelDoc ?? undefined}
            title={`${profile.name} demo reel`}
            loading={reelDoc ? undefined : 'lazy'}
            allow="autoplay; fullscreen; encrypted-media; picture-in-picture"
            allowfullscreen
          />
        </div>
      )}
    </section>

    {bands.map((band) => (
      <section class="band" aria-labelledby={`${band.id}-title`}>
        <h2 class="band__title" id={`${band.id}-title`}>{band.title}</h2>
        <nav class="category-links" aria-label={band.title}>
          {band.items.map(({ category, entries: items }, i) => (
            <a href={withBase(`/work/c/${category.key}/`)} style={`--i: ${i}`}>
              <span class="category-links__label">{category.label}</span>
              <span class="category-links__count">{items.length}</span>
            </a>
          ))}
        </nav>
      </section>
    ))}

    {featured.length > 0 && (
      <section class="band" aria-labelledby="featured-title">
        <h2 class="band__title" id="featured-title">Featured</h2>
        <div class="grid">
          {featured.map((e, i) => (
            <Tile href={withBase(`/work/${e.id}/`)} title={e.data.title} eyebrow={tileMeta(e)} subtitle={e.data.position || undefined} image={e.data.cover} index={i} edit={`work/item/${e.id}`} />
          ))}
        </div>
      </section>
    )}

    {latest.length > 0 && (
      <section class="band" aria-labelledby="latest-title">
        <h2 class="band__title" id="latest-title">Latest</h2>
        <div class="grid">
          {latest.map((e, i) => (
            <Tile href={withBase(`/work/${e.id}/`)} title={e.data.title} eyebrow={tileMeta(e)} subtitle={e.data.position || undefined} image={e.data.cover} index={i} edit={`work/item/${e.id}`} />
          ))}
        </div>
      </section>
    )}

    {skillList.length > 0 && (
      <section class="band" aria-labelledby="skills-title">
        <h2 class="band__title" id="skills-title">Tools</h2>
        <ul class="pills pills--quiet">{skillList.map((s) => <li>{s}</li>)}</ul>
      </section>
    )}

    {entries.length === 0 && <p class="muted">Nothing published yet.</p>}
  </main>
</BaseLayout>
