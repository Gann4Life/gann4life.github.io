---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tile from '../components/Tile.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import EditLink from '../components/EditLink.astro';
import { profile } from '../profile';
import { embedUrl, getWork, groupByCategory, skills, tileMeta, toolSlug } from '../lib/work';
import { formatDate, getPosts, homeOrder } from '../lib/blog';
import { withBase } from '../lib/paths';
import { getImage, Image } from 'astro:assets';
import { siteAppearance } from '../lib/appearance';

const entries = await getWork();
const posts = await getPosts();
const latestPosts = homeOrder(posts).slice(0, 3);
const chips = groupByCategory(entries).map((g) => g.category);

const reel = profile.reel ? embedUrl('video', profile.reel) : null;
const isReel = (e: (typeof entries)[number]) => e.data.media.some((m) => m.src === profile.reel);
const featured = entries.filter((e) => e.data.featured && !isReel(e));
const latest = entries.filter((e) => !e.data.featured && !isReel(e)).slice(0, 8);
const skillList = skills(entries).slice(0, 12);
const reelEntry = entries.find(isReel);
const reelPoster =
  reel && reelEntry?.data.cover ? (await getImage({ src: reelEntry.data.cover, format: 'webp', width: 1280 })).src : null;
const reelPlay = reel ? `${reel}${reel.includes('?') ? '&' : '?'}autoplay=1` : null;
const reelTitle = `${profile.name} demo reel`;
const { photo, banner } = siteAppearance;
const bannerSrc =
  banner?.kind === 'asset'
    ? (await getImage({ src: banner.image, format: 'webp', width: 1920 })).src
    : banner?.kind === 'url'
      ? banner.src
      : null;
---

<BaseLayout title={profile.name}>
  <main class="home">
    <section
      class:list={['hero', { 'hero--reel': reel, 'hero--banner': bannerSrc }]}
      style={bannerSrc ? `--hero-banner-image: url("${bannerSrc}")` : undefined}
    >
      <div class="hero__text">
        <p class="hero__kicker">Portfolio</p>
        <EditLink path="singleton/profile" label="Edit profile" />
        {photo ? (
          <div class="hero__id">
            {photo.kind === 'asset' ? (
              <Image class="hero__photo" src={photo.image} width={160} height={160} widths={[160, 320]} sizes="160px" format="webp" alt="" loading="eager" />
            ) : (
              <img class="hero__photo" src={photo.src} width="160" height="160" loading="eager" decoding="async" alt="" />
            )}
            <h1 class="hero__name">{profile.name}</h1>
          </div>
        ) : (
          <h1 class="hero__name">{profile.name}</h1>
        )}
        {profile.tagline && <p class="hero__roles">{profile.tagline}</p>}
        {profile.bio && <p class="hero__bio">{profile.bio}</p>}
        <ProfileLinks links={profile.links} class="icon-links--hero" />
      </div>
      {reel && (
        <div class="hero__reel">
          {reelPoster ? (
            <a class="reel-facade" href={reelPlay} data-title={reelTitle} aria-label={`Play the ${reelTitle}`}>
              <img src={reelPoster} alt="" />
              <span aria-hidden="true"></span>
            </a>
          ) : (
            <iframe
              src={reel}
              title={reelTitle}
              loading="lazy"
              allow="autoplay; fullscreen; encrypted-media; picture-in-picture"
              allowfullscreen
            />
          )}
        </div>
      )}
    </section>

    {(chips.length > 0 || posts.length > 0) && (
      <nav class="home-chips" aria-label="Browse">
        <ul class="pills">
          {chips.map((c) => <li><a href={withBase(`/work/c/${c.key}/`)}>{c.label}</a></li>)}
          {posts.length > 0 && <li><a href={withBase('/blog/')}>Blog</a></li>}
        </ul>
      </nav>
    )}

    {featured.length > 0 && (
      <section class="band" aria-labelledby="featured-title">
        <h2 class="band__title" id="featured-title">Featured</h2>
        <div class="grid">
          {featured.map((e, i) => (
            <Tile href={withBase(`/work/${e.id}/`)} title={e.data.title} eyebrow={tileMeta(e)} subtitle={e.data.position || undefined} image={e.data.cover} index={i} edit={`work/item/${e.id}`} />
          ))}
        </div>
      </section>
    )}

    {latest.length > 0 && (
      <section class="band" aria-labelledby="latest-title">
        <h2 class="band__title" id="latest-title">Latest</h2>
        <div class="grid">
          {latest.map((e, i) => (
            <Tile href={withBase(`/work/${e.id}/`)} title={e.data.title} eyebrow={tileMeta(e)} subtitle={e.data.position || undefined} image={e.data.cover} index={i} edit={`work/item/${e.id}`} />
          ))}
        </div>
      </section>
    )}

    {skillList.length > 0 && (
      <section class="band" aria-labelledby="skills-title">
        <h2 class="band__title" id="skills-title">Tools</h2>
        <ul class="pills">{skillList.map((s) => <li><a href={withBase(`/work/t/${toolSlug(s)}/`)}>{s}</a></li>)}</ul>
      </section>
    )}

    {latestPosts.length > 0 && (
      <section class="band" aria-labelledby="posts-title">
        <h2 class="band__title" id="posts-title">Latest posts</h2>
        <div class="grid">
          {latestPosts.map((p, i) => (
            <Tile href={withBase(`/blog/${p.id}/`)} title={p.data.title} eyebrow={formatDate(p.data.date)} subtitle={p.data.summary || undefined} image={p.data.cover} index={i} headingLevel={3} edit={`blog/item/${p.id}`} />
          ))}
        </div>
        <p class="band__more"><a class="button" href={withBase('/blog/')}>All posts →</a></p>
      </section>
    )}

    {entries.length === 0 && <p class="muted">Nothing published yet.</p>}
  </main>
</BaseLayout>

<script>
  document.querySelector<HTMLAnchorElement>('.reel-facade')?.addEventListener('click', (event) => {
    event.preventDefault();
    const facade = event.currentTarget as HTMLAnchorElement;
    const player = document.createElement('iframe');
    player.src = facade.href;
    player.title = facade.dataset.title ?? '';
    player.allow = 'autoplay; fullscreen; encrypted-media; picture-in-picture';
    player.allowFullscreen = true;
    facade.replaceWith(player);
  });
</script>
