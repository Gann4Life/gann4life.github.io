---
import { linkText, type Work } from '../lib/work';

interface Props {
  links: Work['data']['links'];
}

const { links } = Astro.props;
---

{links.length > 0 && (
  <ul class="link-buttons">
    {links.map((link) => (
      <li>
        <a
          class="button"
          data-type={link.type}
          href={link.url}
          target="_blank"
          rel="noopener"
        >
          {linkText(link)}
        </a>
      </li>
    ))}
  </ul>
)}
