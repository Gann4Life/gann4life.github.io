---
import Pager from './Pager.astro';
import PostArticle from './PostArticle.astro';
import { profile } from '../profile';
import { formatDate, type Post } from '../lib/blog';
import { withBase } from '../lib/paths';
import { editHooks } from '../lib/edit-hooks';

/** Blog split view (docs/3-pages.md): list pane + reader for the selected post; mode 'index' for /blog/ and /blog/page/<n>/, 'post' for /blog/<slug>/. */
interface Props {
  mode: 'index' | 'post';
  posts: Post[];
  selected: Post;
  current: number;
  last: number;
}

const { mode, posts, selected, current, last } = Astro.props;
---

<main class:list={['blog', mode === 'index' ? 'blog--index' : 'blog--post']}>
  <div class="blog__split">
    <aside class="blog__side">
      <p class="hero__kicker"><a href={withBase('/')}>{profile.name}</a> / Blog</p>
      {mode === 'index' ? <h1 class="blog__title">Blog</h1> : <p class="blog__title">Blog</p>}
      <nav aria-label="Posts">
        <ol class="post-list">
          {posts.map((p) => (
            <li>
              <a href={withBase(`/blog/${p.id}/`)} aria-current={p.id === selected.id ? 'page' : undefined}>
                <span class="post-list__title">{p.data.title}</span>
                <span class="post-list__meta">
                  <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                  {p.data.pinned && <span class="mark mark--pinned">Pinned</span>}
                  {p.data.featured && <span class="mark mark--featured">Featured</span>}
                  {p.data.draft && <span class="mark mark--draft">Draft</span>}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <Pager compact current={current} last={last} href={(n) => withBase(n === 1 ? '/blog/' : `/blog/page/${n}/`)} />
    </aside>
    <article class="blog__reader" {...(mode === 'post' ? editHooks.entry('blog', selected.id) : {})}>
      {mode === 'post' && <p class="blog__back"><a href={withBase('/blog/')}>← All posts</a></p>}
      <PostArticle post={selected} level={mode === 'post' ? 1 : 2} link={mode === 'index'} editable={mode === 'post'} />
    </article>
  </div>
</main>
