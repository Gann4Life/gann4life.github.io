---
import { withBase } from '../lib/paths';
/** Dev-only "Edit" link into Keystatic; production builds contain no trace of it. path is the route after /keystatic/, e.g. "collection/work/item/beatlords". */
interface Props {
  collection?: 'work' | 'blog';
  id?: string;
  inPlace?: boolean;
  keystatic?: string;
  label?: string;
  class?: string;
}

const { collection, id, inPlace = false, keystatic, label = 'Edit', class: className } = Astro.props;
---

{import.meta.env.DEV && (
  keystatic ? (
    <a class:list={['edit-link', className]} href={withBase(`/keystatic/${keystatic}`)} target="_blank" rel="noopener" title={label}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm17.71-10.21a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg>
      <span>{label}</span>
    </a>
  ) : inPlace ? (
    <button type="button" class:list={['edit-link', className]} data-edit-open>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm17.71-10.21a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg>
      <span>{label}</span>
    </button>
  ) : (
    <a class:list={['edit-link', className]} href={withBase(`/${collection}/${id}/?edit`)}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm17.71-10.21a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg>
      <span>{label}</span>
    </a>
  )
)}
