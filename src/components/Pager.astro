---
/** Page navigation: first, last and pages around the current one; href(n) gives the URL of page n (base path included); compact shows arrows only. Renders nothing for a single page. */
interface Props {
  current: number;
  last: number;
  href: (n: number) => string;
  compact?: boolean;
}

const { current, last, href, compact } = Astro.props;

const numbers: (number | '…')[] = [];
for (let n = 1; n <= last; n++) {
  if (n === 1 || n === last || Math.abs(n - current) <= 1) numbers.push(n);
  else if (numbers.at(-1) !== '…') numbers.push('…');
}
---

{last > 1 && (
  <nav class:list={['pager', { 'pager--compact': compact }]} aria-label="Pages">
    {current > 1 ? <a class="pager__step" href={href(current - 1)} rel="prev" aria-label={compact ? 'Previous page' : undefined}>{compact ? '←' : '← Previous'}</a> : <span class="pager__step" aria-hidden="true"></span>}
    <ol>
      {numbers.map((n) =>
        n === '…' ? (
          <li class="pager__gap" aria-hidden="true">…</li>
        ) : (
          <li>
            <a href={href(n)} aria-current={n === current ? 'page' : undefined}>{n}</a>
          </li>
        ),
      )}
    </ol>
    {current < last ? <a class="pager__step" href={href(current + 1)} rel="next" aria-label={compact ? 'Next page' : undefined}>{compact ? '→' : 'Next →'}</a> : <span class="pager__step" aria-hidden="true"></span>}
  </nav>
)}
