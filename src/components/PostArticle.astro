---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import EditLink from './EditLink.astro';
import { formatDate, type Post } from '../lib/blog';
import { getWork } from '../lib/work';
import { withBase } from '../lib/paths';

/** A post rendered in full, shared by the blog reader and the home Blog feed (docs/3-pages.md). */
interface Props {
  post: Post;
  level: 1 | 2 | 3;
  link: boolean;
  pinnedMark?: boolean;
  sizes?: string;
}

const { post, level, link, pinnedMark = false, sizes = '(max-width: 48rem) 100vw, 60vw' } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const related = (await getWork()).filter((e) => data.work.includes(e.id));
const TitleHeading = `h${level}` as 'h1' | 'h2' | 'h3';
const RelatedHeading = `h${level + 1}` as 'h2' | 'h3' | 'h4';
---

<EditLink keystatic={`collection/blog/item/${post.id}`} />
<p class="detail__meta">
  <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
  {pinnedMark && data.pinned && <span class="mark mark--pinned">Pinned</span>}
  {data.draft && <span class="draft-note">Draft</span>}
</p>
<TitleHeading class="blog__post-title">
  {link ? <a href={withBase(`/blog/${post.id}/`)}>{data.title}</a> : data.title}
</TitleHeading>
{data.summary && <p class="detail__position">{data.summary}</p>}
{data.cover && (
  <Picture
    class="detail__cover"
    src={data.cover}
    formats={['avif', 'webp']}
    widths={[640, 1280, 1920]}
    sizes={sizes}
    alt=""
  />
)}
<div class="prose">
  <Content />
</div>
{related.length > 0 && (
  <section class="detail__section">
    <RelatedHeading>Related work</RelatedHeading>
    <ul class="related">
      {related.map((e) => <li><a href={withBase(`/work/${e.id}/`)}>{e.data.title}</a></li>)}
    </ul>
  </section>
)}
