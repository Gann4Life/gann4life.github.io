---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import EditLink from './EditLink.astro';

/** 4:3 tile with text over the image, cropped to fill; typographic without an image. index staggers the cascade animation; headingLevel follows the page outline (2 under an h1, 3 under an h2); edit (dev only) is the Keystatic item, e.g. "work/item/beatlords"; draft dims the tile (drafts only reach the dev server). */
interface Props {
  href: string;
  title: string;
  image?: ImageMetadata;
  eyebrow?: string;
  subtitle?: string;
  index?: number;
  size?: 'large' | 'normal';
  edit?: string;
  headingLevel?: 2 | 3;
  draft?: boolean;
}

const { href, title, image, eyebrow, subtitle, index = 0, size = 'normal', edit, headingLevel = 3, draft = false } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<div class="tile-wrap">
  <a class:list={['tile', `tile--${size}`, { 'tile--plain': !image, 'tile--draft': draft }]} href={href} style={`--i: ${index}`}>
    {image && (
      <Picture
        class="tile__image"
        src={image}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200]}
        sizes={size === 'large' ? '(max-width: 48rem) 100vw, 50vw' : '(max-width: 40rem) 100vw, (max-width: 80rem) 50vw, 25vw'}
        alt=""
        loading={index < 8 ? 'eager' : 'lazy'}
      />
    )}
    <div class="tile__text">
      {eyebrow && <p class="tile__eyebrow">{eyebrow}</p>}
      <Heading class="tile__title">{title}</Heading>
      {subtitle && <p class="tile__subtitle">{subtitle}</p>}
    </div>
  </a>
  {edit && <EditLink collection="work" id={edit} class="edit-link--tile" />}
</div>
