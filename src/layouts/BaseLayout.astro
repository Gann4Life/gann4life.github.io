---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import { profile } from '../profile';
import ProfileLinks from '../components/ProfileLinks.astro';
import { getWork, groupByCategory } from '../lib/work';
import { getPosts } from '../lib/blog';
import { withBase } from '../lib/paths';
import { DEPLOY_TARGET } from 'astro:env/server';

interface Props {
  title: string;
  description?: string;
  image?: string;
  currentCategory?: string;
}

const { title, description = profile.tagline || `Work by ${profile.name}`, image, currentCategory } = Astro.props;
const pageTitle = title === profile.name ? title : `${title} — ${profile.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const categories = groupByCategory(await getWork()).map((g) => g.category);
const hasBlog = (await getPosts()).length > 0;
const path = Astro.url.pathname;
const staging = DEPLOY_TARGET === 'staging';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {staging && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    {!staging && <link rel="sitemap" href={withBase('/sitemap.xml')} />}
    <meta name="theme-color" content="#08080b" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-header__name" href={withBase('/')}>{profile.name}</a>
      {(categories.length > 0 || hasBlog) && (
        <nav class="site-header__nav" aria-label="Site">
          {categories.map((c) => (
            <a href={withBase(`/work/c/${c.key}/`)} aria-current={path.startsWith(withBase(`/work/c/${c.key}/`)) ? 'page' : c.key === currentCategory ? 'true' : undefined}>
              {c.label}
            </a>
          ))}
          {hasBlog && (
            <a href={withBase('/blog/')} aria-current={path.startsWith(withBase('/blog/')) ? 'page' : undefined}>Blog</a>
          )}
        </nav>
      )}
    </header>
    <slot />
    <footer class="site-footer">
      <ProfileLinks links={profile.links} />
      <p>© {new Date().getFullYear()} {profile.name}</p>
    </footer>
  </body>
</html>
